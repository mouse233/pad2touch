# Build outputs, diagnostics and local delivery packages
/target/
/artifacts/
/dist/
*.exe
*.dll
*.pdb
*.zip
*.log

# Machine-specific test reports must never be published with project docs.
/local-reports/
/test-results/
/docs/**/*-results.md
/docs/**/*-report.md
/docs/**/*-reports.md

# Physical-device recordings stay local. Optional tests load these at runtime.
/tests/fixtures/*
!/tests/fixtures/README.md

# Credentials, environment overrides and private machine configuration
.env
.env.*
!.env.example
.aws/
.ssh/
.azure/
.config/gcloud/
.cargo/credentials
.cargo/credentials.toml
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
*.local
*.local.*

# Machine-specific editor, agent and OS files
/.agents/
/.codex/
/.commandcode/
/.idea/
/.vscode/
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
